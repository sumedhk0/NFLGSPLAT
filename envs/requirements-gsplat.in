# Direct pins for the nfl_gsplat environment, uv/pip flavour.
#
# Mirrors envs/environment_gsplat.yml. That conda spec still works and is what
# the other three envs use; this one exists because the gsplat env is the only
# one the field-training job needs, conda took 30-60 min to solve it, and two
# separate attempts died in conda's package extraction
# (CondaVerificationError: libabseil ... appears to be corrupted -- a full or
# inode-capped filesystem, not a bad package). uv resolves the same stack in
# ~23 s and installs only wheels, so it cannot fail that way.
#
# Every pin is load-bearing; see environment_gsplat.yml for the reasoning. In
# short: nerfstudio 1.1.3 hard-pins opencv-python, gsplat and viser to these
# exact versions, and typer 0.12.3 needs click<8.2.
#
# Regenerate the lock (from any OS -- uv resolves cross-platform):
#
#   uv pip compile envs/requirements-gsplat.in \
#       --python-version 3.10 \
#       --python-platform x86_64-unknown-linux-gnu \
#       --extra-index-url https://download.pytorch.org/whl/cu121 \
#       --index-strategy unsafe-best-match \
#       -o envs/requirements-gsplat-linux-py310.txt
#
# The extra index and --index-strategy unsafe-best-match are REQUIRED: they are
# what make torch resolve to 2.3.1+cu121 instead of the CPU build on PyPI. uv
# omits them from the lock's own generated header, so they are recorded here.

torch==2.3.1
torchvision==0.18.1
numpy==1.26.4
omegaconf==2.3.0
typer==0.12.3
click==8.1.7
rich==13.7.1
opencv-python==4.8.0.76
gsplat==1.0.0
nerfstudio==1.1.3
viser==0.1.27
trimesh==4.3.2
plyfile==1.0.3
imageio==2.34.1
imageio-ffmpeg==0.5.1
tqdm
